include LICENSE
include NOTICE
include README.md
include START_HERE_FOR_AI.md
include CHANGELOG.md
include docs/distribution-model.md
include requirements-release.txt
recursive-include LICENSES *
recursive-include bootstrap *
recursive-include contracts *.json
recursive-include providers *.json *.md *.txt
recursive-include docs *.png
recursive-include examples *.md *.py
recursive-include models *.json
recursive-include orchestration *.yaml
recursive-include policies *.json
recursive-include registry *.json *.jsonl *.toml *.yaml
recursive-include runtime *.py
recursive-include scripts *.py
recursive-include templates *
recursive-include tests test_*.py
recursive-include .agents SKILL.md *.yaml *.md *.py
include .px/skill-index.json
recursive-include .px/skills *
recursive-include .ai *.toml
recursive-include .codex *
recursive-include .cursor *
recursive-include .github *
recursive-include .vscode *
recursive-include .windsurf *

# Mutable control outputs are never release source inputs.
exclude .engineering-bootstrap/release.lock
exclude .engineering-bootstrap/release-transaction.json
exclude .engineering-bootstrap/processing-order/repair-campaign.json
exclude .engineering-bootstrap/processing-order/release-identity.json
exclude .engineering-bootstrap/test-evidence/.test-orchestration.lock
exclude .px/mcp-runtime-probe.json
exclude extension/SHA256SUMS.txt
exclude evidence/release/rejected-marketplace-upload/pacify-x-vscode-0.6.87-c412addf-rejected-license-path.vsix
exclude registry/.operational-gap-ledger.lock
exclude registry/completion_status.json
exclude registry/operational_gap_ledger.head.json
exclude registry/px_world_state.json
prune .engineering-bootstrap/admission-payloads
prune .engineering-bootstrap/test-evidence
prune .engineering-bootstrap/resource-lifecycle
prune .engineering-bootstrap/wal
prune registry/.lock-recovery-receipts
prune registry/operational_gap_ledger.deltas
exclude registry/operational_gap_ledger.jsonl
exclude registry/operational_gap_ledger.snapshot.json

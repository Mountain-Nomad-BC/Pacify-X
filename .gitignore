# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/
*.whl
extension/node_modules/
extension/dist/
extension/.vscode-test/
extension/evidence/
extension/tests/artifacts/

# Virtual environments and local environment files
.venv/
.venv*/
venv/
env/
Python/
.env
.env.*
!.env.example

# PACIFY-X local runtime custody (retained and audited outside source control)
.engineering-bootstrap/operation-bus/
.engineering-bootstrap/coordination/activity/
.engineering-bootstrap/project-map-history/
.engineering-bootstrap/project-map-history-archives/
.engineering-bootstrap/project-map-lock-history/
.engineering-bootstrap/resource-lifecycle/
.engineering-bootstrap/cleanup-receipts/
.engineering-bootstrap/diagnostics/hardware-dashboard-cache.json
.engineering-bootstrap/export-resources.json
.engineering-bootstrap/export-resources.json.lock
.engineering-bootstrap/project-map/retrieval-index.json
.engineering-bootstrap/runtime-core/cache/
.engineering-bootstrap/runtime-core/state.json
# All other runtime-core content is derived local custody. Existing tracked
# historical records remain tracked; newly generated preflight/cache/log
# evidence must never dirty or enter the product source revision.
.engineering-bootstrap/runtime-core/
.engineering-bootstrap/test-evidence/adversarial-repair-gates/
.engineering-bootstrap/test-evidence/github-reconciliation-gates/

# IDE and operating-system residue not owned by this framework
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Framework-local transient release controls
.engineering-bootstrap/release.lock
.engineering-bootstrap/release-transaction.json

# Recoverable intake/quarantine belongs outside the deployable product
temp/
temp_*/
.tmp/
.tmp_*/
/.tmp_*
.VSCodeCounter/
.engineering-bootstrap/coordination/
.px/global-skill-isolation/
registry/.operational-gap-ledger.lock
tmp_*.json
docs/tmp_*.md
quarantine/
repo_quarantine/

# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/
*.whl
extension/node_modules/
extension/dist/
extension/.vscode-test/
extension/evidence/
extension/tests/artifacts/

# Virtual environments and local environment files
.venv/
.venv*/
venv/
env/
Python/
.env
.env.*
!.env.example

# PACIFY-X local runtime custody (retained and audited outside source control)
.pacify-x/
.agentic_engineering_os_px/operation-bus/
.agentic_engineering_os_px/coordination/activity/
.agentic_engineering_os_px/project-map-history/
.agentic_engineering_os_px/project-map-history-archives/
.agentic_engineering_os_px/project-map-lock-history/
.agentic_engineering_os_px/resource-lifecycle/
.agentic_engineering_os_px/cleanup-receipts/
.agentic_engineering_os_px/diagnostics/hardware-dashboard-cache.json
.agentic_engineering_os_px/export-resources.json
.agentic_engineering_os_px/export-resources.json.lock
.agentic_engineering_os_px/project-map/retrieval-index.json
.agentic_engineering_os_px/runtime-core/cache/
.agentic_engineering_os_px/runtime-core/state.json
# All other runtime-core content is derived local custody. Existing tracked
# historical records remain tracked; newly generated preflight/cache/log
# evidence must never dirty or enter the product source revision.
.agentic_engineering_os_px/runtime-core/
.agentic_engineering_os_px/processing-order/
.agentic_engineering_os_px/test-evidence/adversarial-repair-gates/
.agentic_engineering_os_px/test-evidence/github-reconciliation-gates/

# Derived local custody: live runtime state, budget/WAL ledgers, and resource
# custody are retained and audited OUTSIDE source control. They are local
# execution state, not authored product source, and must never enter the
# product source revision.
.agentic_engineering_os_px/local-model-runtime/
.agentic_engineering_os_px/model-client-gateway/
.agentic_engineering_os_px/resources/ledger.json
.agentic_engineering_os_px/resources/ledger.json.lock

# Per-skill usage memory is derived local runtime custody, not authored source.
# No skill's memory/ is tracked anywhere in this repository; stats.json is a
# rebuildable rollup over the append-only memory/usage.jsonl. Admitting it would
# put local outcome counters into the product source revision.
.px/skills/*/memory/

# IDE and operating-system residue not owned by this framework
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Framework-local transient release controls
.agentic_engineering_os_px/release.lock
.agentic_engineering_os_px/release-transaction.json

# Recoverable intake/quarantine belongs outside the deployable product
temp/
temp_*/
.tmp/
.tmp_*/
/.tmp_*
.VSCodeCounter/
.agentic_engineering_os_px/coordination/
.px/global-skill-isolation/
registry/.operational-gap-ledger.lock
tmp_*.json
docs/tmp_*.md
quarantine/
repo_quarantine/
.quarantine/
.px-quarantine/

.tmp/


# Rebuildable rollup over append-only ledger deltas; never admit to git custody.
# The whole live ledger surface (head pointer, snapshot, and delta segments) is
# local execution state that is continuously rewritten by the runtime. It is
# regenerated on demand and is never uploaded with the repository.
registry/operational_gap_ledger.jsonl
registry/operational_gap_ledger.head.json
registry/operational_gap_ledger.snapshot.json
registry/operational_gap_ledger.deltas/

# Legacy beta runtime custody and experience state are not new source.
.engineering-bootstrap/
orchestration/workflows/*/memory/
providers/agency_agents/agents/*/memory/

# Live governed test receipts have separate local evidence custody.
.agentic_engineering_os_px/test-evidence/sections/
.agentic_engineering_os_px/test-evidence/section-chunks/

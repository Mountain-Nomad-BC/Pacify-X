{
  "schema_version": "1.0",
  "python_requires": ">=3.11,<3.15",
  "python_minors": ["3.11", "3.12", "3.13", "3.14"],
  "operating_systems": ["Windows", "Linux", "Darwin"],
  "ci_runners": {
    "Windows": "windows-latest",
    "Linux": "ubuntu-latest",
    "Darwin": "macos-latest"
  },
  "platform_checks": [
    "path-semantics",
    "advisory-file-locking",
    "permission-boundaries",
    "lf-line-endings"
  ]
}

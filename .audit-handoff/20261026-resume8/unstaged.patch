+      totalBytes += Buffer.byteLength(entry, 'utf8');
+      if (totalBytes > MAX_REDACT_BYTES) {
+        out[key] = '[redacted]';
+        continue;
+      }
+      out[key] = redacted;
+    }
+    return out;
+  }
+  return '[redacted]';
+}

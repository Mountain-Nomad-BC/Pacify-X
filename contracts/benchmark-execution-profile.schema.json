{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:benchmark-execution-profile",
  "title": "Frozen benchmark execution treatment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "lane", "benchmark", "agent", "model", "pacify_x", "limits", "permissions", "retry_policy", "environment", "frozen", "frozen_hash", "comparison_hash"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "lane": {"enum": ["preflight", "cold", "control", "analysis", "improvement", "regression"]},
    "benchmark": {"type": "object"},
    "agent": {"type": "object"},
    "model": {"type": "object"},
    "pacify_x": {"type": "object"},
    "limits": {"type": "object"},
    "permissions": {"type": "object"},
    "retry_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["max_retries", "retryable_classes"],
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0},
        "retryable_classes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "environment": {"type": "object"},
    "hardware_route": {"type": ["object", "null"]},
    "adapter_hashes": {"type": "object"},
    "frozen": {"const": true},
    "frozen_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "comparison_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:project_stream:decision_record",
  "title": "Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "project_id",
    "title",
    "decision",
    "status",
    "evidence"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^dec_"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_"
    },
    "title": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^dec_"
      }
    }
  }
}

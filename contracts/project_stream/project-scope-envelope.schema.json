{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:project_stream:project-scope-envelope",
  "title": "Project execution scope envelope",
  "type": "object",
  "required": [
    "workspace_id",
    "project_id",
    "agent_id",
    "session_id",
    "workstream_id",
    "lease_id",
    "intent_id",
    "correlation_id"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "workstream_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:project_stream:workflow-request",
  "title": "Bounded project-stream workflow request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "project_id",
    "session_id",
    "idempotency_key",
    "approved_effects",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 3
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[A-Za-z0-9_-]+$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "approved_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "read_local",
          "write_workspace",
          "run_process",
          "network",
          "external_write"
        ]
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 120
    },
    "payload": {
      "type": "object"
    }
  }
}

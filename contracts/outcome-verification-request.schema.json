{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:outcome-verification-request",
  "title": "Authoritative outcome verification request",
  "type": "object",
  "required": ["outcome_id", "project_id", "task_id", "execution_id", "postcondition_contract", "policy_decision_ref", "evidence_refs", "evidence_store", "accepted_producers"],
  "properties": {
    "outcome_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string"},
    "postcondition_contract": {"type": "string", "minLength": 1},
    "policy_decision_ref": {"type": "string", "pattern": "^evidence:[A-Za-z0-9._-]+$"},
    "evidence_store": {"type": "string", "minLength": 1},
    "accepted_producers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "max_age_seconds": {"type": "integer", "minimum": 1},
    "evidence_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["ref"], "additionalProperties": false,
        "properties": {
          "ref": {"type": "string", "pattern": "^evidence:[A-Za-z0-9._-]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:candidate-admission-request",
  "title": "Authoritative candidate admission request",
  "type": "object",
  "required": [
    "project_id",
    "evidence_store",
    "accepted_producers",
    "evidence_refs",
    "schema_version",
    "subject_source",
    "assessment_contract"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_store": {
      "type": "string",
      "minLength": 1
    },
    "accepted_producers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 64
    },
    "max_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "evidence_refs": {
      "type": "object",
      "required": [
        "provenance",
        "license",
        "tests",
        "security"
      ],
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "type": "string",
          "pattern": "^evidence:[A-Za-z0-9._-]+$"
        },
        "license": {
          "type": "string",
          "pattern": "^evidence:[A-Za-z0-9._-]+$"
        },
        "tests": {
          "type": "string",
          "pattern": "^evidence:[A-Za-z0-9._-]+$"
        },
        "security": {
          "type": "string",
          "pattern": "^evidence:[A-Za-z0-9._-]+$"
        }
      }
    },
    "schema_version": {
      "const": "2.0"
    },
    "subject_source": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical project-relative locator acquired as a bounded current image."
    },
    "assessment_contract": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical project-relative locator acquired as a bounded current image."
    }
  },
  "additionalProperties": false
}

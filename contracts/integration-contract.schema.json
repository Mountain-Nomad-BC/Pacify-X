{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:integration-contract",
  "title": "Executable integration contract",
  "type": "object",
  "required": [
    "id", "version", "owner", "status", "handler", "healthcheck",
    "provides", "consumes", "effects", "uses", "approval", "rollback"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "candidate", "disabled"]},
    "handler": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_]*$"},
    "healthcheck": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_]*$"},
    "provides": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "consumes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "effects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "uses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "approval": {"type": "object", "required": ["required"], "properties": {"required": {"type": "boolean"}}, "additionalProperties": false},
    "rollback": {"type": "object", "required": ["strategy"], "properties": {"strategy": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:cognitive:behavioral-delta-certificate",
  "title": "Behavioral delta certificate",
  "type": "object",
  "required": ["schema_version", "baseline_sha256", "candidate_sha256", "case_count", "results", "private_reasoning_collected", "certified", "certificate_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "baseline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case_count": {"type": "integer", "minimum": 1},
    "results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "private_reasoning_collected": {"const": false},
    "certified": {"type": "boolean"},
    "certificate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}

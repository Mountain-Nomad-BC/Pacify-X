{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:semantic:semantic-entity",
  "title": "PX Canonical Semantic Entity",
  "description": "The one contract for every modeled object in Pacify-X. Identity is derived from stable intrinsic facts and never from a filesystem location, so an entity survives rename and move. Location is deliberately NOT part of identity and is owned separately by SEM-002 locator records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_id",
    "entity_kind",
    "identity_basis",
    "lifecycle",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "px.semantic-entity/1.0"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^pxe1:[0-9a-f]{32}$",
      "description": "Content-addressed identity. Stable across rename, move and reformat."
    },
    "entity_kind": {
      "type": "string",
      "enum": [
        "declaration",
        "contract",
        "module",
        "operation",
        "symbol",
        "surface",
        "record",
        "artifact",
        "policy",
        "relation_kind"
      ]
    },
    "identity_basis": {
      "type": "object",
      "description": "The exact facts the identity digest was computed from. Retained so identity is auditable and reproducible, not merely opaque.",
      "additionalProperties": false,
      "required": ["basis_kind", "qualifier"],
      "properties": {
        "basis_kind": {
          "type": "string",
          "enum": [
            "intrinsic_name",
            "intrinsic_content",
            "declared_identifier",
            "structural_signature"
          ]
        },
        "qualifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\s\\S]{1,512}$",
          "description": "Basis-kind-specific input, normalized before hashing."
        },
        "content_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["proposed", "accepted", "retired"]
        },
        "accepted_utc": { "type": ["string", "null"] },
        "retired_utc": { "type": ["string", "null"] },
        "retirement_reason": { "type": ["string", "null"], "pattern": "^[\\s\\S]{0,1000}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_by"],
      "properties": {
        "declared_by": { "type": "string", "minLength": 1, "pattern": "^[\\s\\S]{1,200}$" },
        "observed_utc": { "type": ["string", "null"] },
        "governing_contract": { "type": ["string", "null"], "pattern": "^[\\s\\S]{0,300}$" },
        "notes": { "type": ["string", "null"], "pattern": "^[\\s\\S]{0,2000}$" }
      }
    },
    "terms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "^[\\s\\S]{1,300}$" },
      "maxItems": 256,
      "description": "Search terms. Presentation only; never part of identity."
    }
  }
}
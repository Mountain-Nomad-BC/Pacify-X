              ],
              "properties": {
                "source_revision": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                },
                "semantic_generation": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                },
                "projection_generation": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,

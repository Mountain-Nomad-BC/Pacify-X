{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:task_execution_plan",
  "title": "PX TaskExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "project_id", "source_revision", "created_utc",
    "task_envelope_sha256", "route_receipt_sha256", "package_id",
    "package_receipt_sha256", "projection_revisions", "selected_capabilities",
    "effect_budget", "authority_bindings", "attachments", "model_attachment",
    "model_ranking_receipt", "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": "px.task-execution-plan/1.0"},
    "plan_id": {"type": "string", "pattern": "^task-plan-[0-9a-f]{24}$"},
    "project_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "task_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "route_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "package_id": {"type": "string", "minLength": 1},
    "package_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "projection_revisions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "selected_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "effect_budget": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attachments": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "model_attachment": {"type": ["object", "null"]},
    "model_ranking_receipt": {"type": ["object", "null"]},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

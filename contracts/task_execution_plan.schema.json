                },
                "model_execution_group_revision": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                },
                "model_contract_set_revision": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                },
                "gremlin_revision": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                },
                "network_policy_revision": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,

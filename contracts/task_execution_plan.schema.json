                },
                "workflow_adapter_revision": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            },
            "required_components": {
              "type": "array",
              "minItems": 1,
              "maxItems": 14,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "source_revision",
                  "semantic_generation",
                  "projection_generation",
                  "runtime_epoch",
                  "model_fabric_generation",
                  "retrieval_generation",
                  "authority_revision",
                  "policy_revision",
                  "execution_graph_revision",
                  "model_execution_group_revision",
                  "model_contract_set_revision",
                  "gremlin_revision",

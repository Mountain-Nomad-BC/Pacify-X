{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:models:work-disposition",
  "title": "PX work-disposition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "px.work-disposition/1.0"
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "work_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "state": {
            "enum": [
              "completed",
              "blocked",
              "handed_off",
              "superseded",
              "escalated",
              "cancelled"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "work_id",
          "state",
          "reason",
          "target_id"
        ]
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "boundary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "dispositions",
    "boundary_sha256"
  ]
}

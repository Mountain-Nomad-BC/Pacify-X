{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:models:model-router-preset",
  "title": "Per-model frozen router preset binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "executable_sha256",
    "capability_fingerprint_sha256",
    "format_declaration_sha256",
    "format_evidence_sha256",
    "models",
    "preset_sha256",
    "binding_sha256",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "px.model-router-preset/1.0"
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "format_declaration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "format_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "const": false
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "model_sha256",
          "profile_id",
          "profile_sha256",
          "settings_sha256"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "model_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "profile_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "settings_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:validation-contract",
  "title": "Validation contract",
  "type": "object",
  "required": [
    "id",
    "version",
    "risk",
    "required_checks",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

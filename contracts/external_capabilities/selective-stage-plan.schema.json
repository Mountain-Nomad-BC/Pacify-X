{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:external_capabilities:selective-stage-plan",
  "title": "Review-gated project-local external capability stage plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "project_id", "bundle_ids", "body_sha256", "collisions", "unresolved_dependencies", "active_registry_mutation", "authority_granted", "apply_requires_review"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "bundle_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "body_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "collisions": {"type": "array", "items": {"type": "string"}},
    "unresolved_dependencies": {"type": "array", "items": {"type": "string"}},
    "active_registry_mutation": {"const": false},
    "authority_granted": {"const": false},
    "apply_requires_review": {"const": true}
  }
}

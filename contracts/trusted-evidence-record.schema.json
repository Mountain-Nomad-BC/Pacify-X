{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:trusted-evidence-record",
  "title": "Signed trusted evidence record",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_type",
    "producer",
    "project_id",
    "subject_id",
    "created_at",
    "result",
    "signature",
    "content_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "enum": [
        "policy_decision",
        "postcondition",
        "provenance",
        "license",
        "tests",
        "security",
        "transfer_sanitization",
        "human_approval",
        "destination_ownership",
        "transfer_tests"
      ]
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "object"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "namespace",
        "identity",
        "publisher",
        "key_fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ssh-ed25519"
        },
        "namespace": {
          "const": "pacify-x-trusted-evidence"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "key_fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_project_id": {
      "type": "string",
      "minLength": 1
    },
    "destination_project_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation": {
      "type": "object",
      "required": [
        "contract",
        "subject"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "size_bytes",
            "interpretation"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "interpretation": {
              "enum": [
                "outcome-postconditions/1",
                "candidate-assessments/1"
              ]
            }
          }
        },
        "subject": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "size_bytes",
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 67108864
            },
            "kind": {
              "enum": [
                "artifact-file",
                "candidate-manifest"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "contract": {
                "properties": {
                  "interpretation": {
                    "const": "outcome-postconditions/1"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "kind": {
                    "const": "artifact-file"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "contract": {
                "properties": {
                  "interpretation": {
                    "const": "candidate-assessments/1"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "properties": {
                  "kind": {
                    "const": "candidate-manifest"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "description": "The shared runtime resolver additionally enforces byte/count limits, type-specific Boolean assessments, transfer project identities and signer producer/type grants.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0"
          }
        }
      },
      "then": {
        "required": [
          "evaluation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "evaluation"
          ]
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:gremlin-runtime-identity",
  "title": "Gremlin local runtime identity lifecycle record",
  "description": "Metadata-only identity state. The signing key is held by the configured OS-protected credential provider and is never part of this record.",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "authority_id",
        "identity_id",
        "generation",
        "created_at_utc",
        "updated_at_utc",
        "backend_id",
        "signing_key_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "px.gremlin-runtime-identity/1.0" },
        "authority_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "identity_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": { "type": "integer", "minimum": 1 },
        "created_at_utc": { "type": "string", "minLength": 1 },
        "updated_at_utc": { "type": "string", "minLength": 1 },
        "backend_id": { "type": "string", "minLength": 1 },
        "signing_key_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "event_type",
        "authority_id",
        "identity_id",
        "generation",
        "occurred_at_utc",
        "result",
        "backend_id"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "px.gremlin-runtime-identity-event/1.0" },
        "event_type": {
          "enum": [
            "runtime_identity_created",
            "runtime_identity_rotated",
            "runtime_identity_revoked"
          ]
        },
        "authority_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "identity_id": { "type": "string", "format": "uuid" },
        "generation": { "type": "integer", "minimum": 1 },
        "occurred_at_utc": { "type": "string", "minLength": 1 },
        "result": { "const": "succeeded" },
        "backend_id": { "type": "string", "minLength": 1 }
      }
    }
  ]
}

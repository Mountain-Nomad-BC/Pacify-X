{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:operations:route-observer-registry",
  "title": "PACIFY-X route and observer registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "routes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy": {"type": "string", "minLength": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "surface", "owner", "advertised", "status", "effect_classes", "instrumentation", "coverage_tier", "blind_spot_state", "retention_class", "consent", "acceptance_evidence"],
        "properties": {
          "route_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "surface": {"enum": ["runtime", "extension", "mcp", "provider", "operating_system"]},
          "owner": {"type": "string", "minLength": 1},
          "advertised": {"type": "boolean"},
          "status": {"enum": ["active", "partial", "planned", "unsupported"]},
          "effect_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["read", "write", "network", "process", "model", "ui", "approval", "destructive"]}},
          "instrumentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "component", "health"],
            "properties": {
              "kind": {"enum": ["mediator", "observer", "attestation", "none"]},
              "component": {"type": ["string", "null"]},
              "health": {"enum": ["healthy", "degraded", "unconfigured", "unsupported", "unknown"]}
            }
          },
          "coverage_tier": {"enum": ["A", "B", "C", "D"]},
          "blind_spot_state": {"enum": ["none", "partial", "unobserved", "unsupported"]},
          "retention_class": {"enum": ["evidence", "operational", "transient", "none"]},
          "consent": {"enum": ["not_required", "required", "not_granted"]},
          "acceptance_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}

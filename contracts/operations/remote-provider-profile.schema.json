{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:operations:remote-provider-profile",
  "type": "object",
  "required": [
    "schema_version",
    "state",
    "approved_by",
    "evidence_refs",
    "expires_utc",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": "px.remote-provider-profiles/1.0"
    },
    "state": {
      "const": "approved"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "expires_utc": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "provider_id",
          "adapter_id",
          "model_id",
          "model_revision",
          "origin",
          "approved_addresses",
          "credential_reference",
          "context_tokens",
          "max_output_tokens",
          "capabilities",
          "locality",
          "cost_class",
          "grant_id",
          "policy_locator",
          "budget_id",
          "authorized_requesters",
          "revision_evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "provider_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "adapter_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "model_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "model_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "approved_addresses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "credential_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "context_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "capabilities": {
            "type": "object"
          },
          "locality": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "cost_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "policy_locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "budget_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "authorized_requesters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "revision_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:context-generation-vector",
  "title": "PX Context Generation Vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "scope",
    "vector",
    "required_components",
    "vector_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "px.context-generation-vector/1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "semantic_generation",
        "projection_generation",
        "runtime_epoch",
        "model_fabric_generation",
        "retrieval_generation",
        "authority_revision",
        "policy_revision",
        "execution_graph_revision"
      ],
      "properties": {
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "semantic_generation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "projection_generation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "runtime_epoch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "model_fabric_generation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "retrieval_generation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "authority_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "policy_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "execution_graph_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "required_components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "source_revision",
          "semantic_generation",
          "projection_generation",
          "runtime_epoch",
          "model_fabric_generation",
          "retrieval_generation",
          "authority_revision",
          "policy_revision",
          "execution_graph_revision"
        ]
      }
    },
    "vector_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Complete shared component vocabulary, explicit unavailable revisions, required dependency contract and project/scope binding. A valid digest is not proof of live freshness."
}

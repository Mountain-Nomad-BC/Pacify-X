{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:ui-context",
  "title": "UI Context Contract",
  "type": "object",
  "required": [
    "surface_id",
    "route",
    "visible_sections",
    "available_actions",
    "evidence"
  ],
  "properties": {
    "surface_id": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "visible_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "available_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "active_filters": {
      "type": "object"
    },
    "selected_entities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_document": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "total_pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source_id",
        "title",
        "source_type"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "label",
          "value"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {}
        }
      }
    }
  },
  "additionalProperties": false
}

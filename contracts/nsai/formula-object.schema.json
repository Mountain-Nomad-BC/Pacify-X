{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:nsai:formula-object",
  "title": "PX NSAI Canonical Formula Object",
  "description": "One mathematical or logical formula per JSON file with verbatim and normalized forms, variables, assumptions, provenance, and retrieval metadata.",
  "type": "object",
  "required": [
    "schema_version",
    "object_id",
    "object_type",
    "namespace",
    "title",
    "status",
    "semantics",
    "ontology",
    "applicability",
    "formula",
    "content",
    "relationships",
    "provenance",
    "retrieval",
    "authority_granted"
  ],
  "properties": {
    "schema_version": {"const": "px.nsai-formula/1.0"},
    "object_id": {"type": "string", "pattern": "^nsai:[a-z0-9_.-]+:formula:[a-z0-9][a-z0-9_.-]*$"},
    "object_type": {"const": "formula"},
    "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "candidate", "validated", "authoritative", "deprecated", "rejected"]},
    "semantics": {
      "type": "object",
      "required": ["definition", "retrieval_text", "keywords", "intents", "synonyms", "exclusions"],
      "properties": {
        "definition": {"type": "string", "minLength": 1},
        "short_description": {"type": "string"},
        "retrieval_text": {"type": "string", "minLength": 1},
        "keywords": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "intents": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "synonyms": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "ontology": {
      "type": "object",
      "required": ["classes", "facets"],
      "properties": {
        "classes": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "facets": {"type": "object", "additionalProperties": {"anyOf": [{"type": "string"}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}, {"type": "array", "maxItems": 128, "items": {"type": "string"}}]}}
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "required": ["targets", "conditions", "exclusions"],
      "properties": {
        "targets": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "conditions": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "formula": {
      "type": "object",
      "required": ["formula_type", "verbatim_expression", "normalized_expression", "variables", "parameters", "constants", "inputs", "outputs", "assumptions", "constraints", "time_basis", "dynamics", "determinism", "linearity"],
      "properties": {
        "formula_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "verbatim_expression": {"type": "string", "minLength": 1},
        "normalized_expression": {"type": "string", "minLength": 1},
        "variables": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["symbol", "role", "definition", "units", "dimensions"],
            "properties": {
              "symbol": {"type": "string", "minLength": 1},
              "role": {"enum": ["state", "input", "output", "latent", "parameter", "constant", "independent", "dependent"]},
              "definition": {"type": "string", "minLength": 1},
              "units": {"type": "string"},
              "dimensions": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "parameters": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "constants": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "inputs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1}},
        "constraints": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1}},
        "time_basis": {"type": "string"},
        "dynamics": {"enum": ["continuous", "discrete", "mixed", "not_applicable", "unknown"]},
        "determinism": {"enum": ["deterministic", "stochastic", "mixed", "unknown"]},
        "linearity": {"enum": ["linear", "nonlinear", "mixed", "unknown"]}
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": ["summary", "claims", "mechanisms", "notes"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "claims": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["claim_id", "statement", "confidence", "evidence_refs"],
            "properties": {
              "claim_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
              "statement": {"type": "string", "minLength": 1},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "mechanisms": {"type": "array", "maxItems": 128, "items": {"type": "object", "required": ["name", "description"], "properties": {"name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "notes": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "relationships": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["predicate", "target_id", "scope"],
        "properties": {
          "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "target_id": {"type": "string", "pattern": "^nsai:[a-z0-9_.-]+:[a-z][a-z0-9_.-]*:[a-z0-9][a-z0-9_.-]*$"},
          "scope": {"enum": ["library", "external"]}
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sources", "extraction"],
      "properties": {
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["source_id", "kind", "path", "sha256"],
            "properties": {
              "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
              "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
              "archive": {"type": "string"},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "version": {"type": "string"},
              "license": {"type": "string"},
              "citation": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "extraction": {"type": "object", "required": ["method", "generated_by"], "properties": {"method": {"type": "string", "minLength": 1}, "generated_by": {"type": "string", "minLength": 1}, "source_pass": {"type": "string"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "required": ["tags", "terms", "priority"],
      "properties": {
        "tags": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "terms": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "authority_granted": {"const": false}
  },
  "additionalProperties": false
}

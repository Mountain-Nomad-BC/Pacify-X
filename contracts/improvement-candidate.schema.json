{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:improvement-candidate",
  "title": "Non-mutating improvement candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "project_id", "route", "trigger_case_ids", "attribution_refs", "priority", "proposed_action", "admission_required", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "route": {"enum": ["source", "retrieval", "ranking", "reasoning", "scope", "dependency", "freshness", "contradiction_review", "policy_review", "tooling", "oracle_review", "manual_triage"]},
    "trigger_case_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "attribution_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "priority": {"type": "number", "minimum": 0, "maximum": 100},
    "demand_signal": {"type": "number", "minimum": 0},
    "risk": {"type": "number", "minimum": 0, "maximum": 100},
    "proposed_action": {"type": "object"},
    "admission_required": {"const": true},
    "status": {"enum": ["candidate", "reviewed", "admitted", "quarantined", "implemented", "validated", "rejected", "superseded"]}
  }
}

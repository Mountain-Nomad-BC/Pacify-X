{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:memory:semantic-memory-envelope",
  "title": "Structured semantic memory envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "record_type",
    "payload",
    "exact_keys",
    "aliases",
    "tags",
    "entities",
    "relations",
    "required_context",
    "excluded_context",
    "validation_status",
    "validation_checks"
  ],
  "properties": {
    "schema_version": {"const": "px.semantic-memory-envelope/1.0"},
    "namespace": {"type": "string", "minLength": 1},
    "record_type": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "exact_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "aliases": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "entities": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "entity_type", "aliases"],
        "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "entity_type": {"type": "string", "minLength": 1},
          "aliases": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "predicate", "target_id", "confidence", "evidence_locator"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "predicate": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_context": {"type": "object"},
    "excluded_context": {"type": "object"},
    "validation_status": {"enum": ["candidate", "validated", "certified"]},
    "validation_checks": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}

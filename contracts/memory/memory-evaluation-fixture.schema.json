{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:memory:memory-evaluation-fixture",
  "title": "Memory retrieval positive and forbidden fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "query", "project_id", "expected_ids", "forbidden_ids", "max_results", "max_chars"],
  "properties": {
    "fixture_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "expected_ids": {"type": "array", "items": {"type": "string"}},
    "forbidden_ids": {"type": "array", "items": {"type": "string"}},
    "max_results": {"type": "integer", "minimum": 1},
    "max_chars": {"type": "integer", "minimum": 1},
    "holdout": {"type": "boolean"}
  }
}

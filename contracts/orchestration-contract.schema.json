{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:orchestration-contract",
  "title": "Orchestration contract",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "inputs",
    "outputs",
    "steps",
    "parallelism",
    "stop_conditions",
    "resource_budget"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate",
        "admitted",
        "active",
        "deprecated",
        "rejected"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional_depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "parallelism": {
      "type": "object",
      "required": [
        "max_agents",
        "max_test_runners"
      ],
      "properties": {
        "max_agents": {
          "type": "integer",
          "minimum": 1
        },
        "max_test_runners": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resource_budget": {
      "type": "object",
      "required": [
        "max_tool_calls",
        "max_seconds"
      ],
      "properties": {
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

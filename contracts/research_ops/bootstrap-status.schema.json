{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:research_ops:bootstrap-status",
  "title": "Bootstrap Status",
  "type": "object",
  "required": [
    "run_id",
    "started_at",
    "phase",
    "status",
    "artifacts",
    "gates",
    "changes"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "phase": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "blocked",
        "failed",
        "passed",
        "partial",
        "rolled_back"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "path",
          "hash"
        ]
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ]
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "decision"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "object"
    },
    "resume_token": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}

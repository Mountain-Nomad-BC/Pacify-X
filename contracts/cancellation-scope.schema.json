{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:cancellation-scope",
  "title": "Cancellation scope membership and propagation decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "project_id",
    "root_execution_id",
    "members",
    "member_count",
    "authority_granted"
  ],
  "properties": {
    "schema_version": { "const": "px.cancellation-scope/1.0" },
    "scope_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "root_execution_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "member_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "authority_granted": { "const": false }
  }
}
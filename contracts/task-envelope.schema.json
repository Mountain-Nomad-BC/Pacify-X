{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:task-envelope",
  "title": "PACIFY-X Normalized Task Envelope",
  "type": "object",
  "required": [
    "raw_request",
    "primary_objective",
    "secondary_objectives",
    "raw_constraints",
    "constraints",
    "domain",
    "technologies",
    "required_outputs",
    "safety_implications",
    "execution_depth",
    "confidence_requirements",
    "intent",
    "capabilities",
    "entities",
    "aliases",
    "verbs",
    "nouns",
    "semantic_concepts",
    "repository_context_required",
    "task_envelope_sha256"
  ],
  "properties": {
    "raw_request": {"type": "string", "minLength": 1},
    "primary_objective": {"type": "string", "minLength": 1},
    "secondary_objectives": {"type": "array", "items": {"type": "string"}},
    "raw_constraints": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "domain": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "technologies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "safety_implications": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "execution_depth": {"enum": ["bounded", "comprehensive"]},
    "confidence_requirements": {"enum": ["standard", "certification"]},
    "intent": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "entities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verbs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "nouns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "semantic_concepts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "repository_context_required": {"type": "boolean"},
    "task_envelope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}

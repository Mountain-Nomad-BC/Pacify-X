  "additionalProperties": false,
  "properties": {
    "controls": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pack_id": {
      "type": "string"
    },
    "revocation_triggers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "CONDITIONAL"
      ]
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "pack_id",
    "version",
    "status",
    "controls",
    "limitations",
    "revocation_triggers"
  ],
  "type": "object"
}

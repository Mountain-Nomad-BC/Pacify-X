  "additionalProperties": false,
  "properties": {
    "children": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "shared_mechanism": {
      "type": "string"
    },
    "status": {

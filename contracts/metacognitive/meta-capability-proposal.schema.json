    },
    "validation_cases": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "variant_dimensions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "children",
    "shared_mechanism",
    "scope",
    "validation_cases"
  ],
  "type": "object"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-loop-bootstrap:contract:agents:agent-task-envelope",
  "title": "Agent Task Envelope",
  "type": "object",
  "required": [
    "task_id",
    "objective",
    "deliverable",
    "scope",
    "authority",
    "acceptance_criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "deliverable": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "authority": {
      "type": "object",
      "required": [
        "read",
        "write",
        "execute",
        "external_action",
        "destructive"
      ],
      "properties": {
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean"
        },
        "execute": {
          "type": "boolean"
        },
        "external_action": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "approved_targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "reference"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "freshness_as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "memory_namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "additionalProperties": false
}

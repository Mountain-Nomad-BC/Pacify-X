  "implementation_steps": [
    "Define canonical schema and deterministic normalizer.",
    "Map current skill metadata/contracts without inventing unsupported intent.",
    "Include maturity and ambiguity guards.",
    "Reject contradictory or ownerless profiles."
  ],
  "negative_cases": [
    "Positive and negative intent overlap.",
    "Missing canonical owner.",
    "Unsupported maturity claim.",
    "Ambiguous synonym without guard."
  ],
  "focused_tests": [

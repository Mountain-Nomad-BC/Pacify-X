  ],
  "projection_invalidations": [
    "semantic capability index",
    "routing receipts",
    "world state"
  ],
  "evidence_required": [
    "Schema, normalization, and ambiguity vectors."
  ],
  "rollback": "Remove the semantic profile adapter while preserving source skill metadata.",
  "acceptance_criteria": [
    "Every active routable skill can produce one valid semantic profile.",
    "Profiles distinguish negative intent and ambiguity."
  ],


# Example only. Inject real values through a secret manager.
N8N_HOST=n8n.example.invalid
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_EDITOR_BASE_URL=https://n8n.example.invalid
WEBHOOK_URL=https://n8n.example.invalid/
N8N_ENCRYPTION_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE

EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
N8N_LOG_LEVEL=info

{
  "schema_version": "1.0",
  "adapters": [
    {
      "id": "local-runtime",
      "state": "discoverable_unconfigured",
      "discovery_commands": ["ollama", "llama-server", "lmstudio"],
      "credential_mode": "none_or_runtime_managed",
